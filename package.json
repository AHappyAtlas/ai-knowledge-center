{
  "name": "ai-knowledge-center",
  "version": "0.1.21",
  "type": "module",
  "description": "Local AI workflow control center for project-provided knowledge, gates, and dashboards.",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "knowledge-base",
    "codex",
    "mcp",
    "dashboard"
  ],
  "bin": {
    "aikc": "dist/cli/aikc.js",
    "ai-knowledge-center": "dist/cli/aikc.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently \"tsx src/server/index.ts\" \"vite --host 127.0.0.1 --port 5177\"",
    "server": "tsx src/server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json && vite build",
    "smoke:package": "node scripts/smoke-package.cjs",
    "start": "node dist/cli/aikc.js",
    "preview": "npm run build && node dist/cli/aikc.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "init:project": "tsx src/cli/init-project.ts",
    "postinstall": "node -e \"if (process.env.npm_config_global === 'true' || process.env.npm_config_location === 'global') import('./dist/cli/postinstall.js').catch(() => undefined)\""
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@tanstack/react-query": "^5.90.12",
    "cac": "^7.0.0",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.6.2",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.2",
    "ignore": "^7.0.5",
    "lucide-react": "^0.561.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.29.0",
    "sonner": "^2.0.7",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0"
  }
}
